#!/command/with-contenv bash
# shellcheck shell=bash
# The admin UI (compose's ffs-admin) on :8080 (the integration's /metrics, the ingress through
# nginx) and, with the self-hosted accounts, the sign-up gate on :8081. Ready (fd 3) when its
# /healthz answers. Turned off (admin: false): nothing runs, ready at once.
. /usr/lib/firefox-sync/common.sh
ffs_load
if [ "${FFS_ADMIN}" != true ]; then
  echo "The admin UI is off (admin: false)"
  echo >&3
  exec sleep infinity
fi
exec s6-notifyoncheck -d -n 0 -s 1000 -w 2000 -c "/usr/local/bin/ffs-admin healthcheck" \
  /usr/lib/firefox-sync/admin.sh
