#!/command/with-contenv bash
# shellcheck shell=bash
# The link endpoint for the Firefox Sync add-on (/usr/share/firefox-accounts/link-server.js),
# as nobody: it reads only /run/fxa-link/link.env, nobody's, 0400
. /usr/lib/firefox-accounts/common.sh
fxa_load
exec env -i PATH=/usr/local/bin:/usr/bin:/bin "LINK_TOKEN=${FXA_LINK_TOKEN}" LINK_FILE=/run/fxa-link/link.env \
  /command/s6-setuidgid nobody node /usr/share/firefox-accounts/link-server.js
