#!/command/with-contenv bash
# shellcheck shell=bash
# The link endpoint for the Firefox Sync add-on (/usr/share/firefox-accounts/link-server.js),
# as its own user, fxa-link: it reads only /run/fxa-link/link.env, fxa-link's, 0600 (0700 directory)
. /usr/lib/firefox-accounts/common.sh
fxa_load
exec env -i PATH=/usr/local/bin:/usr/bin:/bin "LINK_TOKEN=${FXA_LINK_TOKEN}" LINK_FILE=/run/fxa-link/link.env \
  /command/s6-setuidgid fxa-link node /usr/share/firefox-accounts/link-server.js
