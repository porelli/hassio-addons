#!/command/with-contenv bash
# shellcheck shell=bash
# The pairing server (compose's fxa-pairing, profile pairing) when fxa_pairing_url is set;
# without it the accounts use Mozilla's, and nothing runs here
. /usr/lib/firefox-accounts/common.sh
fxa_load
if [ -z "${FXA_PAIRING_URL}" ]; then
  echo >&3
  exec sleep infinity
fi
exec s6-notifyoncheck -d -n 0 -s 1000 -w 1000 -c "curl -sf -o /dev/null http://127.0.0.1:8000/__heartbeat__" \
  /usr/lib/firefox-accounts/services.sh pairing
