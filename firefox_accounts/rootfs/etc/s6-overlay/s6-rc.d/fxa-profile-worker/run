#!/command/with-contenv bash
# shellcheck shell=bash
# fxa-profile-worker: where the profile server sends the uploaded avatars (127.0.0.1:1113)
exec s6-notifyoncheck -d -n 0 -s 2000 -w 1000 -c "curl -sf -o /dev/null http://127.0.0.1:1113/__heartbeat__" \
  /usr/lib/firefox-accounts/services.sh profile-worker
